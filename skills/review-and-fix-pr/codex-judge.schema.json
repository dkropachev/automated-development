{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "provider": { "type": "string", "const": "OpenAI Codex" },
    "model": { "type": "string", "const": "gpt-5.6-sol" },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidateId": { "type": "string", "minLength": 1 },
          "verdict": { "type": "string", "enum": ["real", "false_positive", "unresolved"] },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "nit"] },
          "scope": { "type": "string", "enum": ["in", "deferred", "out"] },
          "reason": { "type": "string", "minLength": 1 },
          "sourceEvidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/evidence" }
          }
        },
        "required": ["candidateId", "verdict", "severity", "scope", "reason", "sourceEvidence"]
      }
    },
    "newCandidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": { "type": "string", "minLength": 1 },
          "basisType": { "type": "string", "enum": ["claim", "rule", "trigger"] },
          "basis": { "type": "string", "minLength": 1 },
          "mechanisms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "consequence": { "type": "string", "minLength": 1 },
          "defectClass": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": [
              "runtime", "security", "docs", "comments", "tests", "standards",
              "maintainability", "compatibility", "contracts", "performance", "correctness"
            ]
          },
          "locations": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/location" }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/evidence" }
          },
          "duplicateOfCandidateId": { "type": "string" }
        },
        "required": [
          "claim", "basisType", "basis", "mechanisms", "consequence", "defectClass", "category",
          "locations", "evidence", "duplicateOfCandidateId"
        ]
      }
    }
  },
  "required": ["schemaVersion", "provider", "model", "judgments", "newCandidates"],
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        }
      },
      "required": ["path", "line"]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": {
          "anyOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      },
      "required": ["path", "line", "detail"]
    }
  }
}
